app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — jamais commités (voir env.example.dart pour le template)
/lib/core/config/env.dart

# Lib native Isar téléchargée par Isar.initializeIsarCore(download: true)
# lors de `flutter test` — régénérée à la demande, jamais commitée.
/isar.dll
/libisar.so
/libisar.dylib

# Sorties de build Android (rapports Gradle, etc.)
/android/build/
/android/app/build/
